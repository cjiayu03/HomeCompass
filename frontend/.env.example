# Use the same-origin /api proxy (also works through forwarded app URLs).
NEXT_PUBLIC_API_BASE_URL=
# Server-only origin used after validating same-origin browser mutations.
# Must match an explicit backend CORS_ORIGINS entry.
API_PROXY_ORIGIN=http://localhost:3000
# Live API records are the default. Set fixture only for a local UI demo;
# fixture homes are illustrative and never a fallback for failed live requests.
NEXT_PUBLIC_HOME_DATA_MODE=live
# Development already proxies to 127.0.0.1:8000 by default.
# For a deployed frontend, set BACKEND_URL to the HTTPS API origin and leave
# NEXT_PUBLIC_API_BASE_URL unset. Do not use an HTTP BACKEND_URL for production builds.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
