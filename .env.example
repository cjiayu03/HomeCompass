# Copy to .env locally. Never put real keys in Git, screenshots, course PDFs or client code.
APP_NAME=HomeCompass

# Docker Compose local database. Use URL-encoded credentials in DATABASE_URL if special characters are used.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:replace-with-a-local-password@database:5432/app
# Local persistent backend default. Vercel defaults to one asyncpg connection per warm function.
DATABASE_POOL_MAX=10
CORS_ORIGINS=http://localhost:3000

# Cookie security for local auth. Set true behind HTTPS; keep false only for local HTTP development.
AUTH_COOKIE_SECURE=false

# Local direct API URL. For Vercel, leave NEXT_PUBLIC_API_BASE_URL unset so the same-origin Next.js
# rewrite can proxy /api/* to BACKEND_URL without browser CORS configuration.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-only origin used by the Next.js rewrite (set this on the Vercel frontend project).
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# HDB dataset import. Read-only access works without an API key for exploration; a production key is recommended.
DATA_GOV_SG_API_KEY=
HDB_RESALE_DATASET_ID=d_8b84c4ee58e3cfc0ece0d773c8ca6abc
DATA_GOV_SG_DOWNLOAD_HOSTS=data.gov.sg,api-open.data.gov.sg,storage.data.gov.sg

# Optional OneMap Search/routing token for server-side address geocoding.
# Register via https://www.onemap.gov.sg/apidocs/register; check the issued token expiry before use.
# Never expose this value with a NEXT_PUBLIC_ prefix.
ONEMAP_ACCESS_TOKEN=

# Gemini Interactions API. Keep every value server-side. No request is sent until a positive spend cap and rates are set.
# The model is an implementation default, not yet confirmed by the team. Re-check current model/pricing before enabling.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MONTHLY_BUDGET_USD=
GEMINI_MAX_OUTPUT_TOKENS=512
# Example rates only; replace with verified pricing for the selected model before enabling AI.
GEMINI_INPUT_USD_PER_MILLION=0.75
GEMINI_OUTPUT_USD_PER_MILLION=3.75
